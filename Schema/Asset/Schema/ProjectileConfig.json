      }
    },
    "UseModelScale": {
      "type": "boolean",
      "description": "Whether the projectile's scale is derived from the model asset's MinScale/MaxScale range. When false (the default), the projectile always spawns at scale 1.0 regardless of the model's configured range.",
      "markdownDescription": "Whether the projectile's scale is derived from the model asset's MinScale/MaxScale range. When false (the default), the projectile always spawns at scale 1.0 regardless of the model's configured range.",
      "hytale": {
        "type": "boolean",
        "inheritsProperty": true
      },
      "default": false
    },
    "LaunchForce": {
      "type": "number",
      "hytale": {
        "type": "number",
        "inheritsProperty": true
      },
      "default": 1.0
    },
