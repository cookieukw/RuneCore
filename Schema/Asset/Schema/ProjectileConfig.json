  },
  "properties": {
    "Parent": {
      "type": "string",
      "description": "When set this asset will inherit properties from the named asset.\n\nWhen inheriting from another ProjectileConfig most properties will simply be copied from the parent asset to this asset. In the case where both child and parent provide a field the child field will simply replace the value provided by the parent, in the case of nested structures this will apply to the fields within the structure. In some cases the field may decide to act differently, for example: by merging the parent and child fields together.",
      "markdownDescription": "When set this asset will inherit properties from the named asset.\n\nWhen inheriting from another **ProjectileConfig** most properties will simply be copied from the parent asset to this asset. In the case where both child and parent provide a field the child field will simply replace the value provided by the parent, in the case of nested structures this will apply to the fields within the structure. In some cases the field may decide to act differently, for example: by merging the parent and child fields together.",
      "hytaleParent": {
        "type": "ProjectileConfig"
      },
      "hytale": {
        "type": "string"
      }
    },
    "$Title": {
      "description": "Comments don't have any function other than allowing users to add certain internal comments or notes to an asset",
